{
  // Cada proyecto aparece una sola vez. Todos están dentro de la carpeta Códigos,
  // pero PlatformIO solo reconoce un proyecto (y muestra sus botones) si su
  // platformio.ini está en la raíz de una carpeta del workspace.
  // Al crear un proyecto nuevo, agregarlo acá.
  "folders": [
    // Guante (ESP32-S3 Mini)
    { "name": "1. Guante v1", "path": "1. Guante v1" },
    { "name": "1. Guante v2", "path": "1. Guante v2" },
    { "name": "1. Guante v3", "path": "1. Guante v3" },
    // Mano robot (ESP32 + PCA9685)
    { "name": "2. Mano - Servomotores_mano_robot", "path": "2. Mano - Servomotores_mano_robot" },
    { "name": "2. Mano - Servos_esp32_PCA", "path": "2. Mano - Servos_esp32_PCA" },
    // Comunicación ESP-NOW guante -> mano
    { "name": "3. ESP-NOW - Transmisor_C3", "path": "3. ESP-NOW - Transmisor_C3" },
    { "name": "3. ESP-NOW - Receptor_ESP32", "path": "3. ESP-NOW - Receptor_ESP32" },
    // Flex 1 del guante (C3) -> servo de la mano (ESP32): un proyecto, dos entornos
    { "name": "3. ESP-NOW - Prueba_Servo_Sensor", "path": "3. ESP-NOW - Prueba_Servo_Sensor" },
    // Pruebas iniciales con Arduino Uno
    { "name": "4. Arduino - Pruebas_funcionales_flex_servos", "path": "4. Arduino - Pruebas_funcionales_flex_servos" },
    { "name": "4. Arduino - prueba_5_sensores_flex", "path": "4. Arduino - prueba_5_sensores_flex" },
    { "name": "4. Arduino - prueba_potenciometro_servo", "path": "4. Arduino - prueba_potenciometro_servo" },
    { "name": "4. Arduino - prueba_sensores_flex", "path": "4. Arduino - prueba_sensores_flex" },
    { "name": "4. Arduino - Sensor_flex", "path": "4. Arduino - Sensor_flex" }
  ],
  "settings": {
    // El repositorio de Git está en la carpeta raíz del proyecto
    "git.openRepositoryInParentFolders": "always",
    // Revisa cada tanto si hay cambios nuevos en GitHub
    "git.autofetch": true,
    // Al abrir un archivo, PlatformIO cambia solo al proyecto de ese archivo
    "platformio-ide.activateProjectOnTextEditorChange": true,
    // Oculta las carpetas de compilación de PlatformIO
    "files.exclude": { "**/.pio": true }
  },
  // Terminal > Run Task... > "ESP-NOW: monitor transmisor + receptor"
  // abre los dos monitores serie lado a lado (cerrar con el tachito antes de subir codigo)
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Servo-Sensor: monitor receptor (ESP32, COM3)",
        "type": "process",
        "command": "${userHome}/.platformio/penv/Scripts/pio.exe",
        "args": ["device", "monitor", "-d", "${workspaceFolder:3. ESP-NOW - Prueba_Servo_Sensor}", "-e", "receptor_esp32"],
        "isBackground": true,
        "problemMatcher": [],
        "presentation": { "group": "servosensor", "panel": "dedicated", "reveal": "always", "focus": false }
      },
      {
        "label": "Servo-Sensor: monitor transmisor (C3, COM5)",
        "type": "process",
        "command": "${userHome}/.platformio/penv/Scripts/pio.exe",
        "args": ["device", "monitor", "-d", "${workspaceFolder:3. ESP-NOW - Prueba_Servo_Sensor}", "-e", "transmisor_c3"],
        "isBackground": true,
        "problemMatcher": [],
        "presentation": { "group": "servosensor", "panel": "dedicated", "reveal": "always", "focus": true }
      },
      {
        "label": "Servo-Sensor: monitor transmisor + receptor",
        "dependsOn": ["Servo-Sensor: monitor receptor (ESP32, COM3)", "Servo-Sensor: monitor transmisor (C3, COM5)"],
        "dependsOrder": "parallel",
        "problemMatcher": []
      },
      {
        "label": "Servo-Sensor: subir transmisor (C3)",
        "type": "process",
        "command": "${userHome}/.platformio/penv/Scripts/pio.exe",
        "args": ["run", "-d", "${workspaceFolder:3. ESP-NOW - Prueba_Servo_Sensor}", "-e", "transmisor_c3", "-t", "upload"],
        "problemMatcher": []
      },
      {
        "label": "Servo-Sensor: subir receptor (ESP32, mantener BOOT)",
        "type": "process",
        "command": "${userHome}/.platformio/penv/Scripts/pio.exe",
        "args": ["run", "-d", "${workspaceFolder:3. ESP-NOW - Prueba_Servo_Sensor}", "-e", "receptor_esp32", "-t", "upload"],
        "problemMatcher": []
      },
      {
        "label": "ESP-NOW: monitor receptor (ESP32, COM3)",
        "type": "process",
        "command": "${userHome}/.platformio/penv/Scripts/pio.exe",
        // DTR/RTS en 0: si no, el ESP32 queda trabado en modo grabacion
        "args": ["device", "monitor", "-d", "${workspaceFolder:3. ESP-NOW - Receptor_ESP32}", "--dtr", "0", "--rts", "0"],
        "isBackground": true,
        "problemMatcher": [],
        "presentation": { "group": "espnow", "panel": "dedicated", "reveal": "always", "focus": false }
      },
      {
        "label": "ESP-NOW: monitor transmisor (C3, COM5)",
        "type": "process",
        "command": "${userHome}/.platformio/penv/Scripts/pio.exe",
        "args": ["device", "monitor", "-d", "${workspaceFolder:3. ESP-NOW - Transmisor_C3}"],
        "isBackground": true,
        "problemMatcher": [],
        "presentation": { "group": "espnow", "panel": "dedicated", "reveal": "always", "focus": true }
      },
      {
        "label": "ESP-NOW: monitor transmisor + receptor",
        "dependsOn": ["ESP-NOW: monitor receptor (ESP32, COM3)", "ESP-NOW: monitor transmisor (C3, COM5)"],
        "dependsOrder": "parallel",
        "problemMatcher": []
      }
    ]
  }
}
