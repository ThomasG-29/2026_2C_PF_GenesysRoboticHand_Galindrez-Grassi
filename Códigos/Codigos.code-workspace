{
  // Cada proyecto aparece una sola vez. Todos están dentro de la carpeta Códigos,
  // pero PlatformIO solo reconoce un proyecto (y muestra sus botones) si su
  // platformio.ini está en la raíz de una carpeta del workspace.
  // Al crear un proyecto nuevo, agregarlo acá.
  "folders": [
    // Guante (ESP32-S3 Mini)
    { "name": "1. Guante v1", "path": "Conexionado_guante-v1" },
    { "name": "1. Guante v2", "path": "Conexionado_guante-v2" },
    { "name": "1. Guante v3", "path": "Conexionado_guante-v3" },
    // Mano robot (ESP32 + PCA9685)
    { "name": "2. Mano - Servomotores_mano_robot", "path": "Servomotores_mano_robot" },
    { "name": "2. Mano - Servos_esp32_PCA", "path": "Servos_esp32_PCA" },
    // Comunicación ESP-NOW guante -> mano
    { "name": "3. ESP-NOW - Transmisor_C3", "path": "Prueba_ESPNOW/Transmisor_C3" },
    { "name": "3. ESP-NOW - Receptor_ESP32", "path": "Prueba_ESPNOW/Receptor_ESP32" },
    // Pruebas iniciales con Arduino Uno
    { "name": "4. Arduino - Pruebas_funcionales_flex_servos", "path": "Pruebas_funcionales_flex_servos_arduino" },
    { "name": "4. Arduino - prueba_5_sensores_flex", "path": "prueba_5_sensores_flex_arduino" },
    { "name": "4. Arduino - prueba_potenciometro_servo", "path": "prueba_potenciometro_servo_arduino" },
    { "name": "4. Arduino - prueba_sensores_flex", "path": "prueba_sensores_flex" },
    { "name": "4. Arduino - Sensor_flex", "path": "Sensor_flex" }
  ],
  "settings": {
    // El repositorio de Git está en la carpeta raíz del proyecto
    "git.openRepositoryInParentFolders": "always",
    // Revisa cada tanto si hay cambios nuevos en GitHub
    "git.autofetch": true,
    // Al abrir un archivo, PlatformIO cambia solo al proyecto de ese archivo
    "platformio-ide.activateProjectOnTextEditorChange": true,
    // Oculta las carpetas de compilación de PlatformIO
    "files.exclude": { "**/.pio": true }
  }
}
